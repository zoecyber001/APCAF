{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "APCAF_Case_Log",
  "description": "Canonical schema for logging non-invasive APCAF physical security assessment findings, observed conditions, and optional remediation tracking.",
  "type": "object",
  "required": [
    "case_id",
    "case_type",
    "evidence_status",
    "validation_status",
    "timestamp",
    "facility_metadata",
    "assessor_id",
    "findings"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^APCAF-(CASE|DEMO)-[0-9A-Za-z_-]{3,}$"
    },
    "case_type": {
      "type": "string",
      "enum": ["SYNTHETIC_DEMO", "FIELD_OBSERVED", "FIELD_OBSERVED_REVIEWED"],
      "description": "Distinguishes synthetic teaching fixtures from verified real-world field assessments"
    },
    "evidence_status": {
      "type": "string",
      "enum": ["NO_FIELD_EVIDENCE", "PRIMARY_FIELD_EVIDENCE", "INDEPENDENTLY_REVIEWED"],
      "description": "Distinguishes whether case contains real primary field evidence or simulated/fixture data"
    },
    "validation_status": {
      "type": "string",
      "enum": ["unverified", "independently_reviewed", "synthetic_fixture"],
      "description": "Peer validation level for empirical case cataloguing"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "framework_standard": {
      "type": "string"
    },
    "assessor_id": {
      "type": ["string", "null"]
    },
    "authorization_ref": {
      "type": "string",
      "description": "Assessment authorization, client ticket, or scope reference"
    },
    "facility_metadata": {
      "type": "object",
      "required": ["facility_type"],
      "properties": {
        "facility_type": {
          "type": "string",
          "enum": ["datacenter", "corporate_hq", "bank_branch", "critical_infrastructure", "warehouse", "healthcare", "card_production", "other"]
        },
        "applicable_frameworks": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Optional list of regulatory or compliance frameworks designated in assessment scope"
        },
        "regulatory_scope": {
          "type": "array",
          "items": { "type": "string" }
        },
        "target_facility_hash": {
          "type": "string",
          "description": "Anonymized identifier or hash for client data confidentiality"
        },
        "control_owner": {
          "type": "string"
        }
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["control_id", "technique_id", "classification", "observed_spec", "remediation_action"],
        "properties": {
          "control_id": {
            "type": "string"
          },
          "tactic_id": {
            "type": "string"
          },
          "technique_id": {
            "type": "string",
            "pattern": "^PHY-T[0-9]{4}(\\.[0-9]{3})?$"
          },
          "technique_name": {
            "type": "string"
          },
          "classification": {
            "type": "string",
            "enum": ["Hardened", "Deficient", "Condition_Requires_Validation", "Not_Assessed"]
          },
          "susceptibility_assessment": {
            "type": "string",
            "description": "Clarifies observable physical vulnerability condition versus executed exploit"
          },
          "evidence_type": {
            "type": "string",
            "enum": ["measurement", "photo", "device_read", "configuration_verification", "observation", "synthetic_fixture"]
          },
          "evidence_ref": {
            "type": "string",
            "description": "Identifier or hash for physical photo, gauge measurement log, or device capture"
          },
          "evidence_hash": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": ["HIGH", "MEDIUM", "LOW"]
          },
          "measurement_unit": {
            "type": "string"
          },
          "measurement_method": {
            "type": "string"
          },
          "observed_spec": {
            "type": "string"
          },
          "inspection_time_seconds": {
            "type": "integer"
          },
          "mitigation_ref": {
            "type": "string"
          },
          "remediation_action": {
            "type": "string"
          },
          "vendor_warranty_applicable": {
            "type": "boolean"
          }
        }
      }
    },
    "remediation_status": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["OPEN", "IN_PROGRESS", "RESOLVED", "ACCEPTED_RISK", "PENDING", "NO_REMEDIATION_REQUIRED", "VERIFIED_HARDENED"]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "commercial_workflow": {
      "type": "object",
      "description": "Optional APCAF-WF-01 profile for vendor warranty and commercial retainage tracking",
      "properties": {
        "profile": { "type": "string" },
        "warranty_applicable": { "type": "boolean" },
        "punchlist_issued": { "type": "boolean" },
        "invoice_hold": { "type": "boolean" },
        "invoice_hold_status": { "type": "string" },
        "contractor_ref": { "type": "string" },
        "resolution_status": { "type": "string" }
      }
    }
  }
}
