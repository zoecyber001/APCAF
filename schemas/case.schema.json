{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "APCAF_Case_Log",
  "description": "Canonical schema for logging non-invasive APCAF physical security assessment findings, observed conditions, and vendor warranty remediation tracking.",
  "type": "object",
  "required": [
    "case_id",
    "timestamp",
    "facility_metadata",
    "assessor_id",
    "findings",
    "remediation_status"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^APCAF-(CASE|DEMO)-[0-9A-Za-z_-]{3,}$"
    },
    "case_type": {
      "type": "string",
      "enum": ["SYNTHETIC_DEMO", "FIELD_OBSERVED"],
      "description": "Distinguishes synthetic teaching fixtures from verified real-world field assessments"
    },
    "validation_status": {
      "type": "string",
      "enum": ["unverified", "independently_reviewed", "synthetic_fixture"],
      "description": "Peer validation level for empirical case cataloguing"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "framework_standard": {
      "type": "string"
    },
    "assessor_id": {
      "type": "string"
    },
    "authorization_ref": {
      "type": "string",
      "description": "SOW addendum, client ticket, or audit consent authorization reference"
    },
    "facility_metadata": {
      "type": "object",
      "required": ["facility_type", "regulatory_scope"],
      "properties": {
        "facility_type": {
          "type": "string",
          "enum": ["datacenter", "corporate_hq", "bank_branch", "critical_infrastructure", "warehouse", "healthcare", "card_production", "other"]
        },
        "regulatory_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target_facility_hash": {
          "type": "string",
          "description": "Anonymized SHA-256 or pseudo-identifier for client data confidentiality"
        }
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["control_id", "technique_id", "classification", "observed_spec", "remediation_action"],
        "properties": {
          "control_id": {
            "type": "string"
          },
          "tactic_id": {
            "type": "string"
          },
          "technique_id": {
            "type": "string",
            "pattern": "^PHY-T[0-9]{4}(\\.[0-9]{3})?$"
          },
          "technique_name": {
            "type": "string"
          },
          "classification": {
            "type": "string",
            "enum": ["Hardened", "Legacy/Soft", "Partially Hardened"]
          },
          "susceptibility_assessment": {
            "type": "string",
            "description": "Clarifies observable physical vulnerability condition versus executed exploit"
          },
          "evidence_type": {
            "type": "string",
            "enum": ["measurement", "photo", "device_read", "configuration_verification", "observation", "synthetic_fixture"]
          },
          "evidence_ref": {
            "type": "string",
            "description": "Identifier or hash for physical photo, gauge measurement log, or device capture"
          },
          "observed_spec": {
            "type": "string"
          },
          "inspection_time_seconds": {
            "type": "integer"
          },
          "mitigation_ref": {
            "type": "string"
          },
          "remediation_action": {
            "type": "string"
          },
          "vendor_warranty_applicable": {
            "type": "boolean"
          }
        }
      }
    },
    "remediation_status": {
      "type": "object",
      "required": ["ciso_punchlist_issued", "vendor_invoice_hold"],
      "properties": {
        "ciso_punchlist_issued": {
          "type": "boolean"
        },
        "vendor_invoice_hold": {
          "type": "boolean"
        },
        "vendor_resolution": {
          "type": "string",
          "enum": ["PENDING", "REMEDIATED_NO_COST", "NO_REMEDIATION_REQUIRED", "VERIFIED_HARDENED", "DISPUTED", "ACCEPTED_RISK", "UNKNOWN"]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
